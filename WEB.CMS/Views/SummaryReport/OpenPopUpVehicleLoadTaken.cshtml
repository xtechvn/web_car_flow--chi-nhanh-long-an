@using Entities.Models
@using Entities.ViewModels;

<form id="VehicleLoadTaken_update" onsubmit="return false">

    <input style="display:none;" id="id" value="@ViewBag.id" />
    <div class="form-grid">

        <div class="form-group">
          
            <input type="text" class="currency" id="VehicleLoadTaken" name="VehicleLoadTaken" value="@ViewBag.VehicleLoadTaken.ToString("N0")" />
        </div>

    </div>
    <div class="actions">
        <button class="cancel" onclick="$.magnificPopup.close();">Bỏ qua</button>
        <button class="confirm" onclick="_detail_summary_report.UpdateVehicleLoad()">Đồng ý</button>
    </div>


</form>
